---
// File Layout.astro yang bersih
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Desainer Timpa Timpa</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta
      name="description"
      content="DTT (Desainer Timpa Timpa) adalah komunitas bagi desainer grafis di Indonesia untuk berkolaborasi, berbagi karya, dan belajar bersama. Gabung sekarang!"
    />

    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <slot />
    <div id="loading-overlay" class="loading-overlay">
      <div class="spinner"></div>

      <div id="progress-container" class="progress-container">
        <div id="progress-bar" class="progress-bar"></div>
        <span id="progress-text">0%</span>
      </div>
      <p id="loading-text" class="loading-text">Mengunggah karya...</p>
    </div>
  </body>
</html>
