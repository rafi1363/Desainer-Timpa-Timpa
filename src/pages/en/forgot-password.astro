---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils.ts";
const t = useTranslations(Astro);
import { defaultLang } from "../../i18n/ui.ts";

const langPrefix =
  Astro.currentLocale === defaultLang ? "" : `/${Astro.currentLocale}`;
---

<Layout>
  <main class="login-page">
    <div class="login-container">
      <h2 class="section-title">{t("forgot_password.title")}</h2>
      <p style="text-align: center; color: #aaa; margin-bottom: 2rem;">
        {t("forgot_password.subtitle")}
      </p>
      <form id="forgot-form">
        <div class="form-group">
          <label for="email">{t("forgot_password.label.email")}</label>
          <input type="email" id="email" name="email" required />
        </div>
        <button type="submit" class="cta-button"
          >{t("forgot_password.button.send_link")}</button
        >
        <a href={`${langPrefix}/login`} class="back-link"
          >{t("forgot_password.link.remembered")}</a
        >
        <p
          id="message"
          style="min-height: 1.2em; margin-top: 1rem; text-align: center;"
        >
        </p>
      </form>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById("forgot-form");
  const message = document.getElementById("message");
  const submitButton = form.querySelector("button");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    message.textContent = "";
    submitButton.disabled = true;
    submitButton.textContent = "Mengirim...";

    const formData = new FormData(form);
    const response = await fetch("/api/forgot-password", {
      method: "POST",
      body: formData,
    });

    const result = await response.json();
    message.textContent = result.message;

    if (response.ok) {
      message.style.color = "#4ade80"; // Hijau
      form.querySelector("input").disabled = true;
    } else {
      message.style.color = "#dc2626"; // Merah
      submitButton.disabled = false;
      submitButton.textContent = "Kirim Link Reset";
    }
  });
</script>
