---
// Halaman ini sangat mirip dengan /admin/gallery/new.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <main class="admin-page">
    <div class="form-container">
      <h2 class="section-title">Unggah Karya Baru</h2>
      <form id="gallery-form">
        <input type="hidden" id="image_url" name="image_url" />
        <div class="form-group">
          <label for="design_type">Tipe Desain</label>
          <div class="custom-select-wrapper">
            <select id="design_type" name="design_type" required>
              <option value="" disabled selected>Pilih salah satu...</option>
              <option value="Desain Poster">Desain Poster</option>
              <option value="Kolaborasi">Kolaborasi</option>
              <option value="Tagwall">Tagwall</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="image_file">Unggah File Gambar</label>
          <div class="custom-file-upload">
            <input
              type="file"
              id="image_file"
              name="image_file"
              accept="image/*"
              required
            />
            <label for="image_file" class="file-upload-button"
              >Choose File</label
            >
            <span id="file-name-display" class="file-name">No file chosen</span>
          </div>
          <small>Format: JPG, PNG, WEBP. Maks: 5MB.</small>
        </div>
        <div class="form-actions">
          <a href="/member/profile" class="secondary-button">Batal</a>
          <button type="submit" class="cta-button">Unggah Karya</button>
        </div>
      </form>
    </div>
  </main>
</Layout>

<script>
  import imageCompression from "browser-image-compression";
  import {
    showProgressBar,
    updateProgress,
    showSpinner,
    hideOverlay,
  } from "../../scripts/ui-helper";
  document.addEventListener("DOMContentLoaded", () => {
    // --- Elemen-elemen ---
    const form = document.getElementById("gallery-form");
    const fileInput = document.getElementById("image_file");
    const fileNameDisplay = document.getElementById("file-name-display");

    const loadingOverlay = document.getElementById("loading-overlay");
    const spinner = loadingOverlay.querySelector(".spinner");
    const loadingText = document.getElementById("loading-text");

    const progressContainer = document.getElementById("progress-container");
    const progressBar = document.getElementById("progress-bar");
    const progressText = document.getElementById("progress-text");

    // --- Script untuk menampilkan nama file ---
    if (fileInput && fileNameDisplay) {
      fileInput.addEventListener("change", () => {
        fileNameDisplay.textContent =
          fileInput.files.length > 0
            ? fileInput.files[0].name
            : "No file chosen";
      });
    }

    // --- Fungsi Upload ke Cloudinary dengan Progress ---
    const uploadToCloudinary = (file) => {
      return new Promise((resolve, reject) => {
        const formData = new FormData();
        formData.append("file", file);
        formData.append("upload_preset", "hziqmdzw"); // Ganti dengan preset Anda

        const xhr = new XMLHttpRequest();
        xhr.open(
          "POST",
          `https://api.cloudinary.com/v1_1/dsnvmjdni/image/upload`,
          true
        ); // Ganti dengan cloud name Anda

        // Ini bagian untuk melacak progress
        xhr.upload.onprogress = (event) => {
          if (event.lengthComputable) {
            const percentComplete = (event.loaded / event.total) * 100;
            updateProgress(percentComplete); // Gunakan fungsi helper
          }
        };

        xhr.onload = () => {
          if (xhr.status === 200) {
            resolve(JSON.parse(xhr.responseText));
          } else {
            reject(
              new Error("Gagal unggah ke Cloudinary. Status: " + xhr.status)
            );
          }
        };

        xhr.onerror = () => {
          reject(new Error("Terjadi kesalahan jaringan saat mengunggah."));
        };

        xhr.send(formData);
      });
    };

    // --- Event Listener Utama untuk Submit Form ---
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      showProgressBar("Mengunggah karya...");
      const submitButton = form.querySelector('button[type="submit"]');
      const file = fileInput.files[0];
      if (!file) {
        alert("Pilih file gambar terlebih dahulu.");
        return;
      }

      // 1. Tampilkan Overlay & Siapkan UI untuk Upload
      submitButton.disabled = true;
      loadingOverlay.classList.add("active");
      spinner.style.display = "none"; // Sembunyikan spinner
      progressContainer.style.display = "block"; // Tampilkan progress bar
      loadingText.textContent = "Mengunggah karya...";

      try {
        // --- [INI BAGIAN BARUNYA] PROSES KOMPRESI GAMBAR ---
        const options = {
          maxSizeMB: 4, // Maksimal ukuran file setelah kompresi (misal, 2MB)
          maxWidthOrHeight: 1920, // Maksimal lebar atau tinggi gambar
          useWebWorker: true, // Gunakan worker agar tidak membuat UI macet
          onProgress: (p) => {
            console.log(`Compressing: ${p}%`); // Opsional: lihat progres di console
          },
        };

        console.log(
          `Ukuran file asli: ${(file.size / 1024 / 1024).toFixed(2)} MB`
        );
        const compressedFile = await imageCompression(file, options);
        console.log(
          `Ukuran file setelah kompresi: ${(compressedFile.size / 1024 / 1024).toFixed(2)} MB`
        );
        const cloudinaryData = await uploadToCloudinary(compressedFile);
        document.getElementById("image_url").value = cloudinaryData.secure_url;

        showSpinner("Menyimpan data..."); // Ganti ke spinner setelah upload selesai

        const imageUrl = cloudinaryData.secure_url;
        const designType = form.querySelector("#design_type").value;

        const appRes = await fetch("/api/gallery", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            image_url: imageUrl,
            design_type: designType,
          }),
        });

        if (!appRes.ok) {
          const error = await appRes.json();
          throw new Error(error.message);
        }

        window.location.href = `/member/profile?updated=${Date.now()}`;
      } catch (error) {
        hideOverlay(); // Sembunyikan loading dulu
        showErrorModal(error.message); // Lalu tampilkan modal error
        submitButton.disabled = false;
        // Sesuaikan teks tombol kembali
        submitButton.textContent = "Simpan Gambar"; // Untuk admin
        // submitButton.textContent = "Unggah Karya"; // Untuk member
      }
    });
  });
</script>
