---
import { useTranslations } from "../i18n/utils.ts";
const t = useTranslations(Astro);
---

<section id="tentang" class="features">
  <h3 class="section-title">{t("features.title")}</h3>
  <div class="features-grid">
    {/* Card 1: Portofolio */}
    <div class="feature-card hidden-on-scroll">
      <div class="feature-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 9.75h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5-13.5h16.5M3.75 6.75h16.5"
          ></path></svg
        >
      </div>
      <h4>{t("features.portfolio.title")}</h4>
      <p>{t("features.portfolio.body")}</p>
    </div>

    {/* Card 2: Kolaborasi Proyek */}
    <div class="feature-card hidden-on-scroll">
      <div class="feature-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"
          ></path></svg
        >
      </div>
      <h4>{t("features.collaboration.title")}</h4>
      <p>{t("features.collaboration.body")}</p>
    </div>

    {/* Card 3: Eksklusif */}
    <div class="feature-card hidden-on-scroll">
      <div class="feature-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
          ></path></svg
        >
      </div>
      <h4>{t("features.exclusive.title")}</h4>
      <p>{t("features.exclusive.body")}</p>
    </div>

    {/* Card 4: Jaringan dan Koneksi */}
    <div class="feature-card hidden-on-scroll">
      <div class="feature-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"
          ></path></svg
        >
      </div>
      <h4>{t("features.network.title")}</h4>
      <p>{t("features.network.body")}</p>
    </div>

    {/* Card 5: Tips Gfx */}
    <div class="feature-card hidden-on-scroll">
      <div class="feature-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.311a7.5 7.5 0 01-7.5 0c-1.451 0-2.713-.58-3.687-1.562a7.036 7.036 0 01-3.687-1.562"
          ></path></svg
        >
      </div>
      <h4>{t("features.gfx.title")}</h4>
      <p>{t("features.gfx.body")}</p>
    </div>

    {/* Card 6: Tentang DTT */}
    <div class="feature-card hidden-on-scroll">
      <div class="feature-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8.25 6.75h8.25M8.25 12h5.25M8.25 17.25h8.25M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
          ></path></svg
        >
      </div>
      <h4>{t("features.about.title")}</h4>
      <p>{t("features.about.body")}</p>
    </div>
  </div>
</section>
