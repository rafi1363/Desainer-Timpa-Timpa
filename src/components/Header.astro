---
// [BARU] Import helper terjemahan
import { useTranslations } from "../i18n/utils.ts";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { defaultLang } from "../i18n/ui.ts"; // Impor bahasa default
import ThemeToggle from "./ThemeToggle.astro";

const t = useTranslations(Astro); // Otomatis mendeteksi bahasa saat ini (id atau en)

// [LOGIKA BARU] Buat awalan URL berdasarkan bahasa saat ini
const langPrefix =
  Astro.currentLocale === defaultLang ? "" : `/${Astro.currentLocale}`;
---

<!-- Header Section -->
<header id="beranda">
  <a href={langPrefix || "/"}>
    {/* Logo Putih untuk Dark Mode (default) */}
    <img
      class="gallery-logo logo-dark"
      src="/assets/DTT-logo-White.png"
      alt="logo DTT"
    />
    {/* Logo Hitam untuk Light Mode (awalnya disembunyikan) */}
    <img
      class="gallery-logo logo-light"
      src="/assets/DTT-logo-Black.png"
      alt="logo DTT"
    />
  </a>

  <button class="hamburger">
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <div class="nav">
    <!-- <a href="#beranda">Beranda</a> -->
    <a href={`${langPrefix}/#tentang`}>{t("nav.tentang")}</a>
    <a href={`${langPrefix}/gallery`}>{t("nav.galeri")}</a>
    <a href={`${langPrefix}/#event`}>{t("nav.event")}</a>
    <a href={`${langPrefix}/#kontak`}>{t("nav.kontak")}</a>
    <a href={`${langPrefix}/login`}>{t("nav.login")}</a>
    <LanguageSwitcher />
  </div>
</header>

<script is:inline>
  // --- LOGIKA UNTUK MENU HAMBURGER ---
  const hamburger = document.querySelector(".hamburger");
  const navMenu = document.querySelector(".nav");

  if (hamburger && navMenu) {
    hamburger.addEventListener("click", () => {
      hamburger.classList.toggle("active");
      navMenu.classList.toggle("active");
    });
  }

  // --- LOGIKA UNTUK SMOOTH SCROLL ---
  const navLinks = document.querySelectorAll('.nav a[href^="#"]');
  navLinks.forEach((link) => {
    link.addEventListener("click", function (event) {
      event.preventDefault();
      const targetId = this.getAttribute("href");
      const targetElement = document.querySelector(targetId);

      if (targetElement) {
        // Menutup menu hamburger di mobile saat link diklik
        if (hamburger && navMenu) {
          hamburger.classList.remove("active");
          navMenu.classList.remove("active");
        }

        targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });
</script>
