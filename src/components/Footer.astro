---
import { useTranslations } from "../i18n/utils.ts";
const t = useTranslations(Astro);
import { defaultLang } from "../i18n/ui.ts";
const langPrefix =
  Astro.currentLocale === defaultLang ? "" : `/${Astro.currentLocale}`;
---

<!-- Footer -->
<footer id="kontak">
  <div class="footer-grid">
    <div class="footer-column">
      <h4>DTT</h4>
      <p style="color: #aaa; line-height: 1.6; margin-bottom: 1.5rem">
        {t("footer.about")}
      </p>
      <div class="social-links">
        <a href="https://www.instagram.com/dtt.studio?igsh=MW43Zjh6YjZ1bnBicA=="
          ><i class="fab fa-instagram"></i></a
        >
        <a href="https://discord.gg/FwDBBNyh"><i class="fab fa-discord"></i></a>
      </div>
    </div>
    <div class="footer-column">
      <h4>{t("footer.links")}</h4>
      <ul class="footer-links">
        <li><a href="#">{t("footer.links.home")}</a></li>
        <li><a href="#">{t("footer.links.about")}</a></li>
        <li><a href="#">{t("nav.event")}</a></li>
        <li>
          <a href={`${langPrefix}/gallery`}>{t("footer.links.gallery")}</a>
        </li>
        <li><a href="#">{t("footer.links.blog")}</a></li>
        <li><a href="/admin">{t("footer.links.admin")}</a></li>
      </ul>
    </div>
    <div class="footer-column">
      <h4>{t("footer.design_cat")}</h4>
      <ul class="footer-links">
        <li><a href="#">UI/UX Design</a></li>
        <li><a href="#">Graphic Design</a></li>
        <li><a href="#">Motion Graphics</a></li>
        <li><a href="#">Illustration</a></li>
        <li><a href="#">Poster</a></li>
        <li><a href="#">Manipulation</a></li>
      </ul>
    </div>
    <div class="footer-column">
      <h4>{t("footer.contact")}</h4>
      <ul class="footer-links">
        <li><a href="#">web.com blm dibuat forto</a></li>
        <li><a href="#">komun</a></li>
        <li><a href="#">Indonesia</a></li>
        <li><a href="#">Virtual</a></li>
      </ul>
    </div>
  </div>
  <div class="copyright">
    © 2025 DTT - Desainer Timpa Timpa. All rights reserved.
  </div>
</footer>

<script
  is:inline
  src="https://kit.fontawesome.com/9fe38aad02.js"
  crossorigin="anonymous"></script>
